<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_light"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/headerOcr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nibras_dark_navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ocr_title"
            android:textColor="@color/white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipLangLatin"
            style="@style/FilterChip"
            android:text="Latin" />

        <TextView
            android:id="@+id/chipLangArabic"
            style="@style/FilterChip"
            android:text="العربية" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvOcrResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:textColor="@color/gray_dark"
                android:textDirection="anyRtl"
                android:textIsSelectable="true"
                android:textSize="16sp"
                android:lineSpacingExtra="4dp" />
        </ScrollView>

        <ProgressBar
            android:id="@+id/progressOcr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tvOcrStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="60dp"
            android:text="@string/ocr_processing"
            android:textColor="@color/gray_medium" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnCopyText"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_button_primary"
        android:gravity="center"
        android:text="@string/copy_text"
        android:textColor="@color/white"
        android:textStyle="bold" />

</LinearLayout>
